# Google OAuth Client ID (from https://console.cloud.google.com/apis/credentials)
# Authorized JavaScript origins: http://localhost:3002
# Authorized redirect URIs: http://localhost:9000/api/v1/auth/google/callback
VITE_GOOGLE_CLIENT_ID=

# Browser talks DIRECTLY to the API gateway (:9000). The gateway routes to every
# microservice internally and proxies the chat (/ws) + battle (/api/v1/battles/{id}/ws) sockets.
VITE_API_URL=http://localhost:9000/api
VITE_WS_URL=ws://localhost:9000
VITE_CHAT_WS_URL=ws://localhost:9000/ws

# Firebase Cloud Messaging (web push notifications). From
# https://console.firebase.google.com -> Project Settings -> General (the
# six values below) and -> Cloud Messaging -> Web Push certificates (VAPID
# key). Leave blank to keep web push disabled (useFCM degrades gracefully).
#
# DUMMY VALUES FOR TESTING ONLY — not a real Firebase project. These are
# enough to exercise the permission prompt, service worker registration,
# and getToken() call path end-to-end, but getToken() will fail against
# Firebase's real servers (invalid API key), so no token will ever be
# minted and nothing will actually be delivered. Replace with real values
# from a Firebase project before this can send a real push.
VITE_FIREBASE_API_KEY=AIzaSyD-dummyKeyForTestingOnly1234567
VITE_FIREBASE_AUTH_DOMAIN=edulearn-dummy-test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=edulearn-dummy-test
VITE_FIREBASE_STORAGE_BUCKET=edulearn-dummy-test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456ghi789
VITE_FIREBASE_VAPID_KEY=BDummyVapidKeyForTestingPurposesOnly1234567890abcdefghijklmnopqrstuvwxyz
