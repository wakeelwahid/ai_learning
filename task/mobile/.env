# All traffic routes through the API gateway on port 9000.
# Left unset, src/api/client.ts picks the right host per platform at runtime
# (10.0.2.2 for Android emulator, localhost for web/iOS simulator). Only set
# this to override — e.g. your LAN IP for a physical device:
# EXPO_PUBLIC_API_URL=http://192.168.1.x:9000/api
EXPO_PUBLIC_APP_NAME=EduAI

# Google OAuth Client IDs (from https://console.cloud.google.com/apis/credentials)
# Web client ID — used for Android/web OAuth flow:
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Android client ID (if using Android OAuth app):
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS client ID (if using iOS OAuth app):
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
