# ══ USER SERVICE - Environment Configuration ══
# Copy this file to .env and update values for your environment

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME="User Service"
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=user_db
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=change_me_secure_pass_123
# Full async DSN used by SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://svc_user:change_me_secure_pass_123@postgres:5432/user_db

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# IMPORTANT: SECRET_KEY must match the auth_service SECRET_KEY (see config.py)
# Use a random string of at least 32 characters in production
SECRET_KEY=change-this-to-minimum-32-char-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API Gateway ───────────────────────────────────────────────────────────────
# Used for inter-service calls in standalone mode
API_GATEWAY_URL=http://localhost:9000

# ── Inter-Service URLs ────────────────────────────────────────────────────────
# Standalone mode  → route through the API gateway (shown below)
# Full-stack mode  → point directly at the service container, e.g. http://auth_service:8000
AUTH_SERVICE_URL=http://localhost:9000/api/v1/auth
NOTIFICATION_SERVICE_URL=http://localhost:9000/api/v1/notifications

# ── Service-Specific ──────────────────────────────────────────────────────────
# AWS S3 (or other AWS service) — boto3==1.35.0 is listed in requirements.txt
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Frontend origin — used for CORS allowed origins and redirect URLs
FRONTEND_URL=http://localhost:3002

# Parent-student linking caps
MAX_STUDENTS_PER_PARENT=7
MAX_PARENTS_PER_STUDENT=3

# ── Notes ─────────────────────────────────────────────────────────────────────
# Standalone mode  (this file as-is):
#   All inter-service traffic is routed through API_GATEWAY_URL so only this
#   service + its postgres container need to be running (docker-compose up).
#
# Full-stack mode  (override in .env):
#   Set AUTH_SERVICE_URL / NOTIFICATION_SERVICE_URL to direct container
#   addresses (e.g. http://auth_service:8000) when running inside the shared
#   edtech_net Docker network with all services active.
