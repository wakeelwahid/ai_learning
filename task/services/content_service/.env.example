# ══ CONTENT SERVICE - Environment Configuration ══
# Copy this file to .env and update values for your environment

# ─────────────────────────────────────────────
# [Application]
# ─────────────────────────────────────────────
APP_NAME="Content Service"
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# [Database]
# ─────────────────────────────────────────────
POSTGRES_DB=content_db
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=change_me_secure_pass_123
# Full async DSN — used by SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://svc_user:change_me_secure_pass_123@postgres:5432/content_db

# ─────────────────────────────────────────────
# [Redis]
# ─────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_pass_123
REDIS_URL=redis://:change_me_redis_pass_123@redis:6379/0

# ─────────────────────────────────────────────
# [JWT / Auth]
# ─────────────────────────────────────────────
# Must be at least 32 random characters in production
SECRET_KEY=change-this-to-minimum-32-char-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────
# [API Gateway]
# ─────────────────────────────────────────────
# Used for inter-service calls in standalone mode
API_GATEWAY_URL=http://localhost:9000

# ─────────────────────────────────────────────
# [Inter-Service URLs]
# ─────────────────────────────────────────────
# Standalone mode  → route through the API gateway
# Full-stack mode  → point directly at the service container (e.g. http://auth_service:8000)
AUTH_SERVICE_URL=http://localhost:9000/api/v1/auth
USER_SERVICE_URL=http://localhost:9000/api/v1/users

# ─────────────────────────────────────────────
# [Service-Specific — AWS S3]
# boto3 is in requirements.txt; real AWS S3 is optionally supported
# ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your-s3-bucket-name
S3_REGION=us-east-1

# ─────────────────────────────────────────────
# [Service-Specific — MinIO (primary CDN / S3-compatible)]
# MinIO is the primary object storage for content assets
# Default bucket: edtech-content  |  Endpoint: http://minio:9000
# ─────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=edtech-content

# ─────────────────────────────────────────────
# [Service-Specific — Cache TTLs]
# Values in seconds
# ─────────────────────────────────────────────
CHAPTER_CACHE_TTL=300
VIDEO_PROGRESS_CACHE_TTL=60
CONTINUE_WATCHING_CACHE_TTL=120
CATALOG_CACHE_TTL=3600
VIDEO_FEED_CACHE_TTL=600

# ─────────────────────────────────────────────
# [Notes]
# ─────────────────────────────────────────────
# STANDALONE MODE (this docker-compose.yml only):
#   - Postgres and Redis run as sibling containers on content_service_net.
#   - Inter-service calls are routed through API_GATEWAY_URL (e.g. http://localhost:9000).
#   - MinIO must be reachable at MINIO_ENDPOINT; run it separately or add it to this
#     compose file if you don't have a shared MinIO instance.
#
# FULL-STACK MODE (root docker-compose / edtech_net):
#   - Remove or ignore this file; configuration comes from the root .env.
#   - Set AUTH_SERVICE_URL=http://auth_service:8000 (direct container DNS).
#   - DATABASE_URL host becomes the shared Postgres service name.
#   - MINIO_ENDPOINT=http://minio:9000 resolves via the shared network.
