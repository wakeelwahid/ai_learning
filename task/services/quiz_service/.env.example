# ══ QUIZ SERVICE - Environment Configuration ══
# Copy this file to .env and update values for your environment

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Quiz Service"
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=quiz_db
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=change_me_secure_pass_123
DATABASE_URL=postgresql+asyncpg://svc_user:change_me_secure_pass_123@postgres:5432/quiz_db

# ── JWT / Auth ────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-minimum-32-char-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API Gateway ───────────────────────────────────────────────────────────────
# Used for inter-service calls in standalone mode
API_GATEWAY_URL=http://localhost:9000

# ── Inter-Service URLs ────────────────────────────────────────────────────────
# Standalone mode: route through the API gateway
# Full-stack mode: point directly at the service container, e.g. http://auth_service:8000
AUTH_SERVICE_URL=http://localhost:9000/api/v1/auth

# ── Service-Specific ──────────────────────────────────────────────────────────
# Redis — used for caching and session management
REDIS_URL=redis://localhost:6379/3

# RabbitMQ — async messaging via aio-pika (no Celery)
RABBITMQ_URL=amqp://edtech:edtech_rabbit@rabbitmq:5672//

# ── Notes ─────────────────────────────────────────────────────────────────────
# STANDALONE MODE (this docker-compose.yml only):
#   - Only quiz_service + its own Postgres run locally.
#   - Set AUTH_SERVICE_URL to route through API_GATEWAY_URL so that JWT
#     validation calls reach the real auth service running elsewhere.
#   - Redis and RabbitMQ must be reachable from the host (or add them as
#     additional services in this file if needed).
#
# FULL-STACK MODE (root docker-compose.yml with all microservices):
#   - Replace AUTH_SERVICE_URL with the internal container name, e.g.:
#       AUTH_SERVICE_URL=http://auth_service:8000
#   - DATABASE_URL host becomes "quiz_service_postgres" (the container name).
#   - All services share the shared edtech_net bridge network.
