# ══ AI SERVICE - Environment Configuration ══
# Copy this file to .env and update values for your environment

# ─────────────────────────────────────────────
# [Application]
# ─────────────────────────────────────────────
APP_NAME="AI Service"
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# [Database]
# ─────────────────────────────────────────────
POSTGRES_DB=ai_db
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=change_me_secure_pass_123
DATABASE_URL=postgresql+asyncpg://svc_user:change_me_secure_pass_123@postgres:5432/ai_db

# ─────────────────────────────────────────────
# [Redis]
# ─────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_pass_123
REDIS_URL=redis://:change_me_redis_pass_123@redis:6379/0

# ─────────────────────────────────────────────
# [JWT / Auth]
# ─────────────────────────────────────────────
SECRET_KEY=change-this-to-minimum-32-char-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────
# [API Gateway]
# Used for inter-service calls in standalone mode
# ─────────────────────────────────────────────
API_GATEWAY_URL=http://localhost:9000

# ─────────────────────────────────────────────
# [Inter-Service URLs]
# Standalone mode: route through API Gateway
# Full-stack mode: point directly to service:8000
# ─────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:9000/api/v1/auth
PAYMENT_SERVICE_URL=http://localhost:9000/api/v1/payments

# ─────────────────────────────────────────────
# [Qdrant — Vector DB for RAG]
# Client: qdrant-client[asyncio]
# Collections: edtech_syllabus, school_subjects
# ─────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change_me_qdrant_api_key
QDRANT_COLLECTION_SYLLABUS=edtech_syllabus
QDRANT_COLLECTION_SUBJECTS=school_subjects

# ─────────────────────────────────────────────
# [OpenAI]
# Used for: text-embedding-3-small embeddings
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-change_me_openai_api_key
EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────
# [Anthropic / Claude]
# Used for: claude-sonnet-4-6 (chat/generation)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-change_me_anthropic_api_key
CHAT_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────
# [Groq]
# Primary LLM for student RAG queries (fast inference)
# Model: llama-3.1-8b-instant
# ─────────────────────────────────────────────
GROQ_API_KEY=gsk_change_me_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# ─────────────────────────────────────────────
# [Cohere]
# Client: cohere==5.1.8
# ─────────────────────────────────────────────
COHERE_API_KEY=change_me_cohere_api_key

# ─────────────────────────────────────────────
# [Ollama — Local / Offline Embeddings]
# Model: llama3.1:8b (via host.docker.internal)
# Embeddings: sentence-transformers
# ─────────────────────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434
LLM_MODEL=llama3.1:8b
LOCAL_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ─────────────────────────────────────────────
# [MinIO — Object Storage]
# Client: minio==7.2.7
# Bucket: edtech-content (admin file uploads)
# ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_BUCKET=edtech-content

# ─────────────────────────────────────────────
# [Celery / RabbitMQ]
# Client: celery[rabbitmq]==5.4.0
# ─────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ─────────────────────────────────────────────
# [RAG / LLM Tuning]
# ─────────────────────────────────────────────
RAG_CACHE_TTL=3600
CHAPTER_CACHE_TTL=86400
MAX_CONTEXT_CHUNKS=10
MAX_TOKENS_RESPONSE=2048

# ─────────────────────────────────────────────
# [Prompt Versioning]
# ─────────────────────────────────────────────
PROMPT_STUDY_VERSION=v1
PROMPT_GENERAL_VERSION=v1

# ─────────────────────────────────────────────
# [Notes]
# ─────────────────────────────────────────────
# Standalone mode (this docker-compose.yml only):
#   - AUTH_SERVICE_URL / PAYMENT_SERVICE_URL point to API_GATEWAY_URL so the
#     AI service can still call other services through the gateway.
#   - Qdrant, MinIO, RabbitMQ, and Ollama must be running separately (or
#     replace URLs with localhost if running natively outside Docker).
#
# Full-stack mode (root docker-compose.yml):
#   - Replace *_SERVICE_URL values with direct container names, e.g.
#     AUTH_SERVICE_URL=http://auth_service:8000
#   - QDRANT_URL / MINIO_ENDPOINT / RABBITMQ_URL use their container names.
#   - OLLAMA_HOST may remain host.docker.internal or point to an ollama
#     container added to the shared network.

INTERNAL_SERVICE_SECRET=change-me-same-in-every-service
USER_SERVICE_URL=http://user_service:8000

# ── Parent RAG (grounded chat about a linked child) ──────────────────────────
QDRANT_COLLECTION_STUDENT=student_activity
PARENT_RAG_CACHE_TTL=900
PARENT_RAG_REINDEX_SECONDS=3600
PARENT_RAG_CONTEXT_CARDS=10
QUIZ_SERVICE_URL=http://quiz_service:8000
BATTLE_SERVICE_URL=http://battle_service:8000
GAMIFICATION_SERVICE_URL=http://gamification_service:8000
ANALYTICS_SERVICE_URL=http://analytics_service:8000

# ── Chat history & user memory ───────────────────────────────────────────────
# Kept on Redis db 1, away from the caches on db 0: the shared instance runs
# maxmemory-policy allkeys-lru, so anything beside the caches can be evicted.
REDIS_CHAT_URL=redis://:edtech_redis_2024@ai_service_redis:6379/1
CHAT_HISTORY_EXCHANGES=10
CHAT_HISTORY_TTL_DAYS=30
CHAT_SUMMARY_EVERY=5
PARENT_RAG_FACTS_TTL=60
