# ══ REFERRAL SERVICE - Environment Configuration ══
# Copy this file to .env and update values for your environment

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Referral Service"
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=referral_db
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=change_me_secure_pass_123

# Async SQLAlchemy connection string — points to the postgres service in docker-compose
DATABASE_URL=postgresql+asyncpg://svc_user:change_me_secure_pass_123@postgres:5432/referral_db

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Must be at least 32 random characters in production
SECRET_KEY=change-this-to-minimum-32-char-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API Gateway ───────────────────────────────────────────────────────────────
# Used for inter-service calls in standalone mode
API_GATEWAY_URL=http://localhost:9000

# ── Service-Specific ──────────────────────────────────────────────────────────
# Redis is used for caching/rate-limiting (redis[asyncio] client).
# No Celery, S3, Cashfree, SMTP, or Qdrant integrations.
REDIS_URL=redis://localhost:6379/0

# ── Notes ─────────────────────────────────────────────────────────────────────
# Standalone mode  : run `docker compose up` inside this service directory.
#                    The compose file brings up its own Postgres container.
#                    DATABASE_URL should use host "postgres" (the compose service name).
#
# Full-stack mode  : the root-level docker-compose orchestrates all microservices
#                    on a shared network. Point DATABASE_URL at the shared DB host
#                    and ensure SECRET_KEY matches the value used by the auth service.
