# ══ ANALYTICS SERVICE - Environment Configuration ══
# Copy this file to .env and update values for your environment

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME="Analytics Service"
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=analytics_db
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=change_me_secure_pass_123
# Full async DSN consumed by SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://svc_user:change_me_secure_pass_123@postgres:5432/analytics_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_pass_123
# Full DSN consumed by the async Redis client; DB index 0
REDIS_URL=redis://:change_me_redis_pass_123@redis:6379/0

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Must be at least 32 random characters — generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-minimum-32-char-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API Gateway ───────────────────────────────────────────────────────────────
# Used for inter-service calls in standalone mode
API_GATEWAY_URL=http://localhost:9000

# ── Service-Specific ──────────────────────────────────────────────────────────
# This service reads:
#   DATABASE_URL  — PostgreSQL connection via asyncpg (set above)
#   REDIS_URL     — Async Redis client connection (set above)
#   SECRET_KEY    — JWT verification via python-jose (set above)
#
# Instrumentation & logging:
#   prometheus-fastapi-instrumentator exposes /metrics automatically.
#   structlog is used for structured JSON logging; level controlled by LOG_LEVEL.
#
# No external integrations: no S3, Cashfree, SMTP, Qdrant, or other services.
# No inter-service URL references beyond API_GATEWAY_URL above.

# ── Notes ─────────────────────────────────────────────────────────────────────
# STANDALONE MODE  (this file):
#   Runs with its own postgres + redis containers via docker-compose.yml.
#   All connection strings point to container service names (postgres, redis).
#
# FULL-STACK MODE  (root-level .env / edtech_net):
#   DATABASE_URL and REDIS_URL must be updated to point at the shared
#   infrastructure containers (e.g. host=edtech_postgres, db index per service).
#   The network block in docker-compose.yml should reference the shared
#   external network (edtech_net) instead of analytics_service_net.
