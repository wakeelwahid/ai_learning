# â”€â”€â”€ App â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
APP_NAME=EdTech Auth Service
ENV=development
DEBUG=true
LOG_LEVEL=INFO
# This IS the local dev stack, so the OTP dev bypass should stay available
# here — but explicitly via APP_ENV, not via DEBUG. APP_ENV must be the
# exact literal string "development" (anything else, including unset,
# disables the bypass — see config.py / phone_otp_service.py).
APP_ENV=development
DEV_OTP_CODE=000000

