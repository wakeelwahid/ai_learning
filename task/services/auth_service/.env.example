# ══ AUTH SERVICE - Environment Configuration ══
# Copy this file to .env and update values for your environment

# ─────────────────────────────────────────────
# [Application]
# ─────────────────────────────────────────────
APP_NAME="Auth Service"
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# OTP dev-bypass gate (see phone_otp_service.py). APP_ENV must be the EXACT
# literal string "development" to enable the static DEV_OTP_CODE shortcut —
# anything else (missing, blank, "staging", "dev", "Development") fails
# safe and disables it. This is intentionally independent of DEBUG.
#
# Local development (this is what a real dev .env should look like):
APP_ENV=development
DEV_OTP_CODE=000000
#
# Production (what a real production .env should look like — copy this,
# not the block above, when deploying anywhere non-local):
# APP_ENV=production
# DEV_OTP_CODE=

# ─────────────────────────────────────────────
# [Database]
# ─────────────────────────────────────────────
POSTGRES_DB=auth_db
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=change_me_secure_pass_123
# Async SQLAlchemy connection string — host "postgres" matches the compose service name
DATABASE_URL=postgresql+asyncpg://svc_user:change_me_secure_pass_123@postgres:5432/auth_db

# ─────────────────────────────────────────────
# [Redis]
# ─────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_pass_123
# Host "redis" matches the compose service name
REDIS_URL=redis://:change_me_redis_pass_123@redis:6379/0

# ─────────────────────────────────────────────
# [JWT / Auth]
# ─────────────────────────────────────────────
# Must be at least 32 random characters — generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-minimum-32-char-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Number of days of inactivity before a refresh token is invalidated
INACTIVITY_EXPIRE_DAYS=30

# ─────────────────────────────────────────────
# [Email Verification]
# ─────────────────────────────────────────────
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# ─────────────────────────────────────────────
# [OTP]
# ─────────────────────────────────────────────
OTP_MAX_ATTEMPTS=5
OTP_TTL_SECONDS=600

# ─────────────────────────────────────────────
# [Rate Limiting]
# Redis is used as the rate-limit backend
# ─────────────────────────────────────────────
AUTH_RATE_LIMIT=100
REGISTER_RATE_LIMIT=50

# ─────────────────────────────────────────────
# [API Gateway]
# Used for inter-service calls in standalone mode
# ─────────────────────────────────────────────
API_GATEWAY_URL=http://localhost:9000

# ─────────────────────────────────────────────
# [Inter-Service URLs]
# Standalone mode  → point to gateway (http://localhost:9000/api/v1/...)
# Full-stack mode  → point directly to the service (http://service_name:8000)
# ─────────────────────────────────────────────
NOTIFICATION_SERVICE_URL=http://localhost:9000/api/v1/notifications
FRONTEND_URL=http://localhost:3000
OAUTH_REDIRECT_BASE_URL=http://localhost:9000

# ─────────────────────────────────────────────
# [OAuth2 — Google]
# Create credentials at https://console.cloud.google.com/
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ─────────────────────────────────────────────
# [Admin Seed Account]
# Credentials for the default admin user created on first startup
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change_Me_Admin_Password_123!

# ─────────────────────────────────────────────
# [Notes]
# ─────────────────────────────────────────────
# STANDALONE MODE (this docker-compose.yml only):
#   - All three containers (auth_service, postgres, redis) run on the private
#     "auth_service_net" bridge network.
#   - Inter-service URLs should point to the API Gateway on localhost:9000
#     so requests leave the container and re-enter via the host network.
#   - OAuth redirect URIs must also resolve from the browser, so use the
#     public host address (http://localhost:9000/...).
#
# FULL-STACK MODE (root-level docker-compose that includes all microservices):
#   - All services share a common network (e.g. edtech_net).
#   - Replace localhost URLs with Docker service names, e.g.:
#       NOTIFICATION_SERVICE_URL=http://notification_service:8000
#       API_GATEWAY_URL=http://api_gateway:8000
#   - OAUTH_REDIRECT_BASE_URL should still resolve from the browser
#     (use the public domain or load-balancer address).
#
# SECURITY REMINDERS:
#   - Never commit your real .env file to version control.
#   - Rotate SECRET_KEY, POSTGRES_PASSWORD, REDIS_PASSWORD, and ADMIN_PASSWORD
#     before deploying to any non-local environment.
#   - Use Docker secrets or a secrets manager (Vault, AWS Secrets Manager, etc.)
#     for production deployments.
