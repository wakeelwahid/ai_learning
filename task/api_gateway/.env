# â”€â”€â”€ App â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
APP_NAME=EdTech API Gateway
ENV=development
DEBUG=true

# â”€â”€â”€ CORS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Comma-separated list of allowed origins
# Handled centrally by shared/cors.py based on ENV above:
#   ENV=development -> fixed localhost allowlist + CORS_ORIGINS_DEVELOPMENT (optional extra origins, JSON array)
#   ENV=production   -> ONLY CORS_ORIGINS_PRODUCTION (JSON array of real HTTPS domains) -- required, no fallback
# CORS_ORIGINS_DEVELOPMENT=["https://staging.example.com"]
# CORS_ORIGINS_PRODUCTION=["https://app.example.com","https://admin.example.com"]

# â”€â”€â”€ Rate limiting â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
RATE_LIMIT_PER_MINUTE=120

# Route-specific overrides (requests per minute per IP). Dev-friendly values
# below -- tighten these for production, e.g.:
#   RATE_LIMIT_OTP_SEND=5   (SMS costs money per send -- keep this tight in prod)
#   RATE_LIMIT_LOGIN=10     (stricter brute-force protection in prod)
RATE_LIMIT_LOGIN=30
RATE_LIMIT_REGISTER=20
RATE_LIMIT_FORGOT_PASSWORD=5
RATE_LIMIT_OTP_SEND=15
RATE_LIMIT_OTP_VERIFY=20
RATE_LIMIT_AUTH_OTHER=60
RATE_LIMIT_QUIZ_SUBMIT=5
RATE_LIMIT_AI=100
RATE_LIMIT_COUPON_VALIDATE=10

REDIS_PASSWORD=edtech_redis_2024

# Redis used by gateway for rate limiting
# For Docker: injected via docker-compose environment block
# For local dev (no Docker): start redis on port 6387 or change to 6379
REDIS_URL=redis://:redis_secret@localhost:6387

# â”€â”€â”€ Upstream service URLs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
