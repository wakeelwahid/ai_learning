# =============================================================================
# API Gateway — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before starting the gateway.
#
# HOW TO USE
# ----------
# MODE A — Standalone (each microservice runs in its own docker-compose):
#   Services expose host ports 8001-8012 (see port map below).
#   The defaults below (localhost:800X) work as-is on Linux.
#   On Docker Desktop (Mac/Windows) the gateway container reaches the host via
#   host.docker.internal — the docker-compose.yml handles this automatically.
#   Start: docker compose up
#
# MODE B — Full-stack (all services in the root docker-compose.yml):
#   Replace localhost:800X URLs with Docker service names (e.g. http://auth_service:8000)
#   and start with the root-level docker-compose.yml.
# =============================================================================


# -----------------------------------------------------------------------------
# Port Map  (standalone mode)
#   auth_service         → 8001
#   user_service         → 8002
#   content_service      → 8003
#   quiz_service         → 8004
#   payment_service      → 8005
#   notification_service → 8006
#   analytics_service    → 8007
#   gamification_service → 8008
#   referral_service     → 8009
#   battle_service       → 8010
#   career_service       → 8011
#   ai_service           → 8012
#   api_gateway          → 9000
# -----------------------------------------------------------------------------

# Upstream Service URLs — default to localhost ports (MODE A standalone)
AUTH_SERVICE_URL=http://localhost:8001
USER_SERVICE_URL=http://localhost:8002
CONTENT_SERVICE_URL=http://localhost:8003
QUIZ_SERVICE_URL=http://localhost:8004
PAYMENT_SERVICE_URL=http://localhost:8005
NOTIFICATION_SERVICE_URL=http://localhost:8006
ANALYTICS_SERVICE_URL=http://localhost:8007
GAMIFICATION_SERVICE_URL=http://localhost:8008
REFERRAL_SERVICE_URL=http://localhost:8009
BATTLE_SERVICE_URL=http://localhost:8010
CAREER_SERVICE_URL=http://localhost:8011
AI_SERVICE_URL=http://localhost:8012

# Full-stack overrides — uncomment for MODE B (docker service names)
# AUTH_SERVICE_URL=http://auth_service:8000
# USER_SERVICE_URL=http://user_service:8000
# CONTENT_SERVICE_URL=http://content_service:8000
# QUIZ_SERVICE_URL=http://quiz_service:8000
# PAYMENT_SERVICE_URL=http://payment_service:8000
# NOTIFICATION_SERVICE_URL=http://notification_service:8000
# ANALYTICS_SERVICE_URL=http://analytics_service:8000
# GAMIFICATION_SERVICE_URL=http://gamification_service:8000
# REFERRAL_SERVICE_URL=http://referral_service:8000
# BATTLE_SERVICE_URL=http://battle_service:8000
# CAREER_SERVICE_URL=http://career_service:8000
# AI_SERVICE_URL=http://ai_service:8000


# -----------------------------------------------------------------------------
# Redis (gateway-owned — for rate-limiting and response caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://gateway_redis:6379/0


# -----------------------------------------------------------------------------
# Security / Auth
# -----------------------------------------------------------------------------
# REQUIRED: change SECRET_KEY to a long random string in staging/production.
#   Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3002


# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120

# Route-specific overrides (requests per minute per IP). Values below are
# dev-friendly defaults -- tighten for production, e.g.:
#   RATE_LIMIT_OTP_SEND=5   (SMS costs money per send)
#   RATE_LIMIT_LOGIN=10     (stricter brute-force protection)
RATE_LIMIT_LOGIN=30
RATE_LIMIT_REGISTER=20
RATE_LIMIT_FORGOT_PASSWORD=5
RATE_LIMIT_OTP_SEND=15
RATE_LIMIT_OTP_VERIFY=20
RATE_LIMIT_AUTH_OTHER=60
RATE_LIMIT_QUIZ_SUBMIT=5
RATE_LIMIT_AI=100
RATE_LIMIT_COUPON_VALIDATE=10


# -----------------------------------------------------------------------------
# Runtime / Debug
# -----------------------------------------------------------------------------
ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:3002
