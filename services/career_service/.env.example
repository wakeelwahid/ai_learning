# ══ CAREER SERVICE - Environment Configuration ══
# Copy this file to .env and update values for your environment

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME="Career Service"
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=career_db
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=change_me_secure_pass_123
DATABASE_URL=postgresql+asyncpg://svc_user:change_me_secure_pass_123@postgres:5432/career_db

# ── JWT / Auth ────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-minimum-32-char-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Internal service-to-service calls ─────────────────────────────────────────
# Shared secret required by the Docker-network-only /careers/internal/* routes.
INTERNAL_SERVICE_SECRET=change-me-shared-internal-secret

# ── API Gateway ───────────────────────────────────────────────────────────────
API_GATEWAY_URL=http://localhost:9000  # Used for inter-service calls in standalone mode

# ── Groq LLM Inference ───────────────────────────────────────────────────────
# Career Service uses Groq (groq==0.11.0) for LLM-powered career guidance features.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# ── Redis (Caching) ───────────────────────────────────────────────────────────
# Redis (redis==5.1.0) is used for caching LLM responses and session data.
REDIS_URL=redis://localhost:6379/0

# ── Notes ─────────────────────────────────────────────────────────────────────
# Standalone mode  : Run this service independently using docker-compose.yml in
#                    this directory. DATABASE_URL points to the co-located
#                    postgres container; API_GATEWAY_URL points to localhost.
#
# Full-stack mode  : When running as part of the complete EduLearn platform,
#                    DATABASE_URL and REDIS_URL should point to shared
#                    infrastructure, and API_GATEWAY_URL should point to the
#                    central API gateway service (e.g. http://api_gateway:9000).
#                    Ensure SECRET_KEY matches the value used across all services
#                    so that JWT tokens issued by one service are valid in others.
