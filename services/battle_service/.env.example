# ══ BATTLE SERVICE - Environment Configuration ══
# Copy this file to .env and update values for your environment

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Battle Service"
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=battle_db
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=change_me_secure_pass_123
# Async SQLAlchemy connection URL (used by the app container)
DATABASE_URL=postgresql+asyncpg://svc_user:change_me_secure_pass_123@postgres:5432/battle_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_pass_123
REDIS_URL=redis://:change_me_redis_pass_123@redis:6379/0

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# SECRET_KEY must be at least 32 random characters in production
SECRET_KEY=change-this-to-minimum-32-char-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API Gateway ───────────────────────────────────────────────────────────────
# Used for inter-service calls in standalone mode
API_GATEWAY_URL=http://localhost:9000

# ── Inter-Service URLs ────────────────────────────────────────────────────────
# Standalone mode  → route through the API gateway (values below)
# Full-stack mode  → point directly at the service container, e.g. http://gamification_service:8000
GAMIFICATION_SERVICE_URL=http://localhost:9000/api/v1/gamification

# ── Service-Specific: Groq LLM ────────────────────────────────────────────────
# Battle Service uses the Groq LLM API (groq==0.11.0) for AI-powered battle features.
GROQ_API_KEY=your_groq_api_key_here
# Default model; swap for any model available on your Groq plan.
GROQ_MODEL=llama-3.1-8b-instant

# ── Notes ─────────────────────────────────────────────────────────────────────
# STANDALONE MODE (this docker-compose.yml only):
#   - The service runs with its own Postgres and Redis containers.
#   - Inter-service calls must go through API_GATEWAY_URL or a locally running
#     instance of each dependency.
#   - Start with: docker compose up --build
#
# FULL-STACK MODE (root-level docker-compose.yml):
#   - All microservices share a common network (edtech_net).
#   - Set *_SERVICE_URL vars to the internal container name, e.g.:
#       GAMIFICATION_SERVICE_URL=http://gamification_service:8000
#   - DATABASE_URL / REDIS_URL should reference the shared or service-specific
#     containers as configured in the root compose file.
