# ══ GAMIFICATION SERVICE - Environment Configuration ══
# Copy this file to .env and update values for your environment

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Gamification Service"
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=gamification_db
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=change_me_secure_pass_123
DATABASE_URL=postgresql+asyncpg://svc_user:change_me_secure_pass_123@postgres:5432/gamification_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_pass_123
REDIS_URL=redis://:change_me_redis_pass_123@redis:6379/0

# ── JWT / Auth ────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-minimum-32-char-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API Gateway ───────────────────────────────────────────────────────────────
# Used for inter-service calls in standalone mode
API_GATEWAY_URL=http://localhost:9000

# ── Service-Specific ──────────────────────────────────────────────────────────
# No unusual integrations for this service.
# DATABASE_URL, REDIS_URL, and SECRET_KEY are the only required env vars.
# Dependencies: redis[asyncio] for caching/queuing, python-jose for JWT verification.
# No S3, Cashfree, SMTP, Qdrant, or other special dependencies required.

# ── Tunables (cache TTLs / timeouts / business constants) ────────────────────
# HTTP timeout (seconds) for calls to user_service (friends feed).
USER_SERVICE_TIMEOUT_SECONDS=3.0
# Rank-unlock lookup cache TTL (seconds) — keeps 6k+ concurrent users off a per-request COUNT(*) scan.
RANK_UNLOCK_CACHE_TTL_SECONDS=30
# Friends leaderboard cache TTL (seconds).
FRIEND_LEADERBOARD_CACHE_TTL_SECONDS=45
# Free-tier daily usage Redis key TTL (seconds) — expires at midnight + 1 min.
FREE_TIER_KEY_TTL_SECONDS=86460
# Daily-reward claim cooldown (seconds) — 24 hours.
DAILY_REWARD_CLAIM_COOLDOWN_SECONDS=86400
# Number of months in a leaderboard/XP season.
SEASON_DURATION_MONTHS=3
# Minimum XP required to enter a friend-challenge stake battle.
CHALLENGE_MIN_XP=50
# Max streak-freeze shields a user can bank, and EduPoints cost per shield.
STREAK_FREEZE_MAX=3
STREAK_FREEZE_COST_EP=50

# ── Notes ─────────────────────────────────────────────────────────────────────
# STANDALONE MODE (this docker-compose.yml):
#   - Spins up its own postgres and redis containers.
#   - DATABASE_URL host is "postgres" and REDIS_URL host is "redis" — these
#     resolve to the sibling containers inside the gamification_service_net bridge network.
#   - Run with: docker-compose up --build
#
# FULL-STACK MODE (platform-wide docker-compose):
#   - This service joins the shared edtech_net network alongside all other microservices.
#   - Update DATABASE_URL and REDIS_URL to point to the shared platform DB/Redis instances.
#   - SECRET_KEY must match the platform-wide JWT secret used by the Auth Service.
