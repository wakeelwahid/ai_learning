# ══ NOTIFICATION SERVICE - Environment Configuration ══
# Copy this file to .env and update values for your environment
# cp .env.example .env

# ══════════════════════════════════════════════
# [Application]
# ══════════════════════════════════════════════
APP_NAME="Notification Service"
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ══════════════════════════════════════════════
# [Database]
# ══════════════════════════════════════════════
POSTGRES_DB=notification_db
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=change_me_secure_pass_123
# Full async DSN used by the service (points to the postgres container)
DATABASE_URL=postgresql+asyncpg://svc_user:change_me_secure_pass_123@postgres:5432/notification_db

# ══════════════════════════════════════════════
# [Redis]
# ══════════════════════════════════════════════
REDIS_PASSWORD=change_me_redis_pass_123
# Points to the redis container; DB index 0 for app cache/sessions
REDIS_URL=redis://:change_me_redis_pass_123@redis:6379/0

# ══════════════════════════════════════════════
# [JWT / Auth]
# ══════════════════════════════════════════════
# Must be at least 32 characters — generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-minimum-32-char-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ══════════════════════════════════════════════
# [API Gateway]
# ══════════════════════════════════════════════
# Used for inter-service calls in standalone mode
API_GATEWAY_URL=http://localhost:9000

# ══════════════════════════════════════════════
# [Inter-Service URLs]
# ══════════════════════════════════════════════
# Standalone mode  → route through the API gateway (http://localhost:9000/api/v1/...)
# Full-stack mode  → point directly at the service container (http://service_name:8000)
USER_SERVICE_URL=http://localhost:9000/api/v1/users
COURSE_SERVICE_URL=http://localhost:9000/api/v1/courses
ENROLLMENT_SERVICE_URL=http://localhost:9000/api/v1/enrollments

# ══════════════════════════════════════════════
# [Service-Specific — Email (SMTP via aiosmtplib)]
# ══════════════════════════════════════════════
# Configured for Gmail on port 587 (STARTTLS).
# For other providers update SMTP_HOST/SMTP_PORT accordingly.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
EMAIL_FROM_NAME="EduLearn Platform"

# ══════════════════════════════════════════════
# [Service-Specific — WhatsApp]
# ══════════════════════════════════════════════
# API key and sender number for the WhatsApp messaging provider
WHATSAPP_API_KEY=your-whatsapp-api-key-here
WHATSAPP_FROM_NUMBER=+1234567890

# ══════════════════════════════════════════════
# [Service-Specific — Twilio SMS]
# ══════════════════════════════════════════════
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_FROM_NUMBER=+1234567890

# ══════════════════════════════════════════════
# [Service-Specific — Firebase Push Notifications]
# ══════════════════════════════════════════════
# Path to the Firebase service account JSON file (used by firebase-admin SDK)
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
# Legacy FCM server key — kept for reference only, not used by firebase-admin SDK
FCM_SERVER_KEY=your-legacy-fcm-server-key-here

# ══════════════════════════════════════════════
# [Service-Specific — Celery Task Queue]
# ══════════════════════════════════════════════
# Broker: RabbitMQ (primary) — amqp URI pointing to the RabbitMQ container/host
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
# Result backend: Redis (leave empty to derive from REDIS_URL automatically)
CELERY_RESULT_BACKEND=redis://:change_me_redis_pass_123@redis:6379/1

# ══════════════════════════════════════════════
# [Service-Specific — Frontend]
# ══════════════════════════════════════════════
# Used in email templates for links back to the frontend app
FRONTEND_URL=http://localhost:3000

# ══════════════════════════════════════════════
# [Notes]
# ══════════════════════════════════════════════
# STANDALONE MODE (default — this file):
#   - Run `docker compose up` inside this service directory.
#   - Postgres and Redis are spun up as local containers.
#   - Inter-service calls are routed through API_GATEWAY_URL (localhost:9000).
#   - No dependency on the wider EduLearn docker-compose stack.
#
# FULL-STACK MODE (running inside the platform monorepo):
#   - Use the root-level docker-compose and the shared .env at the repo root.
#   - Replace *_SERVICE_URL values with direct container names (e.g. http://user_service:8000).
#   - DATABASE_URL and REDIS_URL point to shared infrastructure containers.
#   - RABBITMQ_URL points to the shared rabbitmq container.
