# ══ PAYMENT SERVICE - Environment Configuration ══
# Copy this file to .env and update values for your environment

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Payment Service"
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=payment_db
POSTGRES_USER=svc_user
POSTGRES_PASSWORD=change_me_secure_pass_123
# Async SQLAlchemy URL — host "postgres" matches the docker-compose service name
DATABASE_URL=postgresql+asyncpg://svc_user:change_me_secure_pass_123@postgres:5432/payment_db

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# SECRET_KEY must be at least 32 random characters in production
SECRET_KEY=change-this-to-minimum-32-char-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API Gateway ───────────────────────────────────────────────────────────────
# Used for inter-service calls in standalone mode, and to build Cashfree's
# return_url / notify_url (must be a URL Cashfree's servers/the user's
# browser can actually reach — a local http://localhost:9000 only works for
# webhook testing via a tunnel, e.g. ngrok).
API_GATEWAY_URL=http://localhost:9000
APP_BASE_URL=http://localhost:9000
# Web frontend base URL — Cashfree redirects the browser/WebView here after
# checkout completes (route: /payment-return?order_id=...).
FRONTEND_URL=http://localhost:3002

# ── Inter-Service URLs ────────────────────────────────────────────────────────
# Standalone mode  → route through API gateway (http://localhost:9000/api/v1/...)
# Full-stack mode  → point directly at the service container (http://auth_service:8000)
AUTH_SERVICE_URL=http://localhost:9000/api/v1/auth
# user_service base URL — used for internal parent-child link verification
# (GET /api/v1/users/internal/parent-link-check). Full-stack mode should
# point directly at the container: http://user_service:8000
USER_SERVICE_URL=http://user_service:8000

# ── Service-Specific: Cashfree (Indian Payment Gateway) ──────────────────────
# Obtain credentials from https://merchant.cashfree.com/merchants/pg/developers/api-keys
# Leave CASHFREE_APP_ID="test" (the default) to run in test_mode — orders are
# mocked locally and /verify auto-succeeds, so the full plan-purchase flow
# works end-to-end with zero real gateway calls until real keys are set here.
CASHFREE_APP_ID=test
CASHFREE_SECRET_KEY=test_secret
# Webhook secret — set in the Cashfree dashboard under Developers → Webhooks;
# used to verify the HMAC signature on incoming /webhook calls.
CASHFREE_WEBHOOK_SECRET=
# "sandbox" while testing against Cashfree's sandbox account, "production" once live.
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# ── Plan seed defaults ────────────────────────────────────────────────────────
# Only used the FIRST time this service boots against an empty `plans` table,
# to seed the initial 3 tiers. After that, all plan data (price/duration/
# features/name/badge/active) is admin-managed via /api/v1/payments/admin/plans
# and stored in the DB — these env vars have no further effect.
PLAN_MONTHLY_AMOUNT=14900
PLAN_QUARTERLY_AMOUNT=29900
PLAN_ANNUAL_AMOUNT=69900

# Currency is hardcoded to INR for this service
CURRENCY=INR

# ── Notes ─────────────────────────────────────────────────────────────────────
# STANDALONE MODE  (docker-compose up in this directory)
#   • Only payment_service + its own Postgres are started.
#   • Set inter-service URLs to go through the API gateway (API_GATEWAY_URL).
#   • DATABASE_URL host must be "postgres" (the docker-compose service name).
#
# FULL-STACK MODE  (started from the root docker-compose in the monorepo)
#   • All microservices share the edtech_net bridge network.
#   • Set inter-service URLs directly to the container service name, e.g.
#       AUTH_SERVICE_URL=http://auth_service:8000
#   • DATABASE_URL host should still be "postgres" (or the shared DB host).
